name: full-mysql-secure-api
region: sfo
services:
- name: fullmysql
  source_dir: server
  github:
    repo: REPLACE_GITHUB_OWNER/REPLACE_REPO
    branch: main
    deploy_on_push: true
  build_command: pip install -r requirements.txt
  run_command: python single_service.py
  environment_slug: python
  http_port: 8080
  instance_count: 1
  instance_size_slug: basic-xs
  health_check:
    http_path: /healthz
    period_seconds: 10
    timeout_seconds: 5
# Single-Service Edition: API + background worker run in ONE App Platform
# service/container. Do not create a separate Worker component.
# Attach the existing Managed MySQL through the DigitalOcean UI, then set the
# runtime environment variables listed in ENVIRONMENT_VARIABLES.txt.
